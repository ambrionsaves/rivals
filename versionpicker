local button2 = createButton("Rivals 1.0.0 (REWRITE)", UDim2.new(0.5, 0, 0.65, 0))

-- Fade out animation
local function closeUI()
    local tween = TweenService:Create(frame, TweenInfo.new(0.3), {
        BackgroundTransparency = 1
    })
    tween:Play()

    for _, v in ipairs(frame:GetChildren()) do
        if v:IsA("TextLabel") or v:IsA("TextButton") then
            TweenService:Create(v, TweenInfo.new(0.3), {
                TextTransparency = 1,
                BackgroundTransparency = 1
            }):Play()
        end
    end

    task.wait(0.35)
    screenGui:Destroy()
end

